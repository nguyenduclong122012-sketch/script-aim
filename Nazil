-- Tính toán màu cầu vồng
local rainbowHue = 0
RunService.RenderStepped:Connect(function(dt)
    rainbowHue = (rainbowHue + dt * 0.3) % 1
end)

local function getRainbowColor()
    return Color3.fromHSV(rainbowHue, 0.9, 1)
end

