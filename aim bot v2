-- Hàm cập nhật màu nút tự động
local function UpdateButtonState(btn, state)
    if state then
        btn.BackgroundColor3 = ActiveBtnColor
    else
        btn.BackgroundColor3 = InactiveBtnColor
    end
end

-- 1. Lưu Cấu Hình
local function SaveConfig()
    if not Auto_Save_Enabled then return end
    if not writefile then return end
    local configData = {
        ESP_Line_Enabled = ESP_Line_Enabled,
        ESP_Wallhack_Enabled = ESP_Wallhack_Enabled,
        ESP_Box_Enabled = ESP_Box_Enabled,
        ESP_Skeleton_Enabled = ESP_Skeleton_Enabled,
        Aim_Mobile_Enabled = Aim_Mobile_Enabled,
        Hitbox_Expander_Enabled = Hitbox_Expander_Enabled,
        Auto_Headshot_Enabled = Auto_Headshot_Enabled,
        FOV_Visible = FOV_Visible,
        FOV_Hidden = FOV_Hidden,
        Aim_FOV = Aim_FOV,
        Graphics_Low_Enabled = Graphics_Low_Enabled,
        Fly_Enabled = Fly_Enabled,
        Clip_Enabled = Clip_Enabled,
        Wall_Shoot_Enabled = Wall_Shoot_Enabled,
        FOV_OffsetX = FOV_OffsetX,
        FOV_OffsetY = FOV_OffsetY,
        Auto_Save_Enabled = Auto_Save_Enabled,
        Auto_Executor_Code = Auto_Executor_Code
    }
    pcall(function()
        writefile(SaveFileName, HttpService:JSONEncode(configData))
    end)
end

-- 2. Tải Cấu Hình
local function LoadConfig()
    if not readfile or not isfile then return end
    if not isfile(SaveFileName) then return end
    pcall(function()
        local data = HttpService:JSONDecode(readfile(SaveFileName))
        ESP_Line_Enabled = data.ESP_Line_Enabled or false
        ESP_Wallhack_Enabled = data.ESP_Wallhack_Enabled or false
        ESP_Box_Enabled = data.ESP_Box_Enabled or false
        ESP_Skeleton_Enabled = data.ESP_Skeleton_Enabled or false
        Aim_Mobile_Enabled = data.Aim_Mobile_Enabled or false
        Hitbox_Expander_Enabled = data.Hitbox_Expander_Enabled or false
        Auto_Headshot_Enabled = data.Auto_Headshot_Enabled or false
        FOV_Visible = data.FOV_Visible or false
        FOV_Hidden = data.FOV_Hidden or false
        Aim_FOV = data.Aim_FOV or 180
        Graphics_Low_Enabled = data.Graphics_Low_Enabled or false
        Fly_Enabled = data.Fly_Enabled or false
        Clip_Enabled = data.Clip_Enabled ~= false
        Wall_Shoot_Enabled = data.Wall_Shoot_Enabled or false
        FOV_OffsetX = data.FOV_OffsetX or 0
        FOV_OffsetY = data.FOV_OffsetY or 0
        Auto_Save_Enabled = data.Auto_Save_Enabled ~= false
        Auto_Executor_Code = data.Auto_Executor_Code or ""
    end)
end
LoadConfig()

